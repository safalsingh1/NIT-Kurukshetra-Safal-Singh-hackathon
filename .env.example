# FinRisk AI Environment Configuration
# Copy this file to .env and configure settings

# ------------------------------------------------------------------
# SEC EDGAR — NO API KEY REQUIRED
# The SEC's data.sec.gov APIs are public and do not require authentication.
# You MUST provide a User-Agent identifying your application and contact.
# Format: "AppName/Version contact@email.com"
# See: https://www.sec.gov/search-filings/edgar-application-programming-interfaces
# ------------------------------------------------------------------
SEC_USER_AGENT=FinRiskAI your-email@example.com

# ------------------------------------------------------------------
# GDELT DOC API — NO API KEY REQUIRED
# Public endpoint. Respects rate limits (no more than 1 req/sec).
# See: https://blog.gdeltproject.org/gdelt-doc-2-0-api-debuts/
# ------------------------------------------------------------------
GDELT_BASE_URL=https://api.gdeltproject.org/api/v2/doc/doc

# ------------------------------------------------------------------
# Optional: Alpha Vantage for live price data
# ------------------------------------------------------------------
# ALPHA_VANTAGE_KEY=your_key_here

# ------------------------------------------------------------------
# Dashboard & API settings
# ------------------------------------------------------------------
STREAMLIT_PORT=8501
API_HOST=0.0.0.0
API_PORT=8000

# ------------------------------------------------------------------
# Demo mode: "true" = use pre-saved CSVs in data/, "false" = live APIs
# ------------------------------------------------------------------
DEMO_MODE=true

# ------------------------------------------------------------------
# Backtesting defaults
# ------------------------------------------------------------------
BACKTEST_START=2023-01-01
BACKTEST_END=2024-01-01
INITIAL_CAPITAL=1000000
